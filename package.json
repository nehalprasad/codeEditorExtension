{
  "name": "Luminos Writting Panel",
  "displayName": "Luminos Writting Panel",
  "description": "A VS Code extension that opens a writing panel.",
  "version": "0.0.1",
  "publisher": "Luminos Indore",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onCommand:luminosChatPanel.start"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "contributes": {
    "commands": [
      {
        "command": "luminosChatPanel.start",
        "title": "Start Luminos Chat Panel"
      }
    ]
  },
  "webviewResources": [
  "src/media/*"
],
  "devDependencies": {
    "@types/node": "^14.0.0",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "node-fetch": "^3.3.2"
  }
}
